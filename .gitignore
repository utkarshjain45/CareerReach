# ==========================================
# CareerReach Root Git Ignore
# ==========================================

# Environment & Secrets
.env
.env.*
!.env.example
*.local

# Build artifacts & Dependencies
node_modules/
dist/
dist-ssr/
target/
*.class
*.jar
*.war
*.ear

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# IDE & Editor files
.idea/
.vscode/
*.iml
*.iws
*.ipr
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
Desktop.ini

# Temporary files
*.tmp
*.bak
*.swp
