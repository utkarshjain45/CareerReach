# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/careerreach_db
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here

# JWT Security
# Ensure this is a 256-bit (or stronger) hex/base64 key for production
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Token Encryption at Rest (AES-256)
APP_ENCRYPTION_KEY=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# Google OAuth 2.0 Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5173/oauth/callback

# Campaign Sending Safety
CAMPAIGN_DELAY_MS=2000

# Server & CORS
PORT=8080
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Supabase Storage Configuration (Private Resume Storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
SUPABASE_BUCKET=careerreach-resumes
SUPABASE_MAX_FILE_SIZE=5242880

